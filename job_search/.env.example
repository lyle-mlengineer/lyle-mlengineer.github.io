# Skipper — every value is optional in development.
# Copy to .env and fill in what you need. Never commit .env.

# dev | prod
SKIPPER_ENV=dev

# Session signing key. Generated into var/secret.key when unset.
# SKIPPER_SECRET_KEY=

# The single account. Used once at first boot to seed the password hash.
SKIPPER_ADMIN_USER=lyle
SKIPPER_ADMIN_PASSWORD=change-me-before-first-boot

SKIPPER_DB_PATH=var/skipper.db
SKIPPER_ARTIFACTS_DIR=var/artifacts
SKIPPER_PORTFOLIO_DIR=data/portfolio

# LLM: groq | nvidia | fake
SKIPPER_LLM_PROVIDER=fake
# Try the other hosted provider when this one is rate limited. Requires the
# other provider's API key below.
SKIPPER_LLM_FALLBACKS=auto

# Groq (openai/gpt-oss)
SKIPPER_GROQ_API_KEY=
SKIPPER_GROQ_BASE_URL=https://api.groq.com/openai/v1
SKIPPER_GROQ_TPM=30000

# NVIDIA NIM free endpoints. DeepSeek V4 pro/flash are retired (410 Gone), so the
# defaults are the current top free models. Get a key at https://build.nvidia.com
SKIPPER_NVIDIA_API_KEY=
SKIPPER_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
SKIPPER_NVIDIA_TPM=40000
# none | high | max — thinking is off by default to keep each job cheap
SKIPPER_NVIDIA_REASONING_EFFORT=none
# Empty uses the current built-in free pair (Kimi K3.1 Pro + Nemotron Lightning).
SKIPPER_NVIDIA_MODEL_LARGE=moonshotai/kimi-k3.1-pro
SKIPPER_NVIDIA_MODEL_SMALL=nvidia/nemotron-3.5-lightning-30b-a3b
# Models tried in order when a pinned id answers 404/410 (retired). Copy live
# ids from https://build.nvidia.com/models; empty uses the built-in chain.
SKIPPER_NVIDIA_MODEL_FALLBACKS=moonshotai/kimi-k3.1-pro,nvidia/nemotron-3.5-lightning-30b-a3b,minimaxai/minimax-m3.1-flash,deepseek-ai/deepseek-v4.1-flash,z-ai/glm-5.3-flash,mistralai/mistral-large-4-1t-a52b

# Leave empty to use the selected provider's default models
SKIPPER_LLM_MODEL_LARGE=
SKIPPER_LLM_MODEL_SMALL=
SKIPPER_LLM_TIMEOUT_S=120
SKIPPER_LLM_MAX_RETRIES=3
SKIPPER_LLM_CACHE_ENABLED=true
# Comma list of providers to try when the primary answers 429/5xx or runs out
# of retries. auto = every other hosted provider whose key is set. none = off.
# A switch is sticky for the rest of the process, so a run does not stall on the
# same rate limit at every step.
SKIPPER_LLM_FALLBACKS=auto
SKIPPER_RUN_TOKEN_BUDGET=120000

# Search: auto | serper | exa | duckduckgo
SKIPPER_SEARCH_PROVIDER=auto
SKIPPER_SERPER_API_KEY=
SKIPPER_EXA_API_KEY=
SKIPPER_SEARCH_MAX_QUERIES=8
SKIPPER_SEARCH_TIMEOUT_S=20
SKIPPER_SEARCH_CACHE_TTL_HOURS=24
# Reuse a company brief across jobs for this many days. 0 = always research.
SKIPPER_RESEARCH_TTL_DAYS=30

# Speech for the interview audio tab: auto | fake | orpheus | elevenlabs | breeze
# auto uses the first key below that is set, otherwise the offline provider.
SKIPPER_TTS_PROVIDER=auto
SKIPPER_ELEVENLABS_API_KEY=
SKIPPER_BREEZE_API_KEY=
# Orpheus runs on the Groq key above.
SKIPPER_TTS_TIMEOUT_S=60
# Empty means the first voice in that provider's catalogue.
SKIPPER_TTS_VOICE_INTERVIEWER=
SKIPPER_TTS_VOICE_INTERVIEWEE=
SKIPPER_TTS_MAX_TURNS=30

# Fetching
SKIPPER_FETCH_MAX_BYTES=3000000
SKIPPER_FETCH_TIMEOUT_S=20
SKIPPER_FETCH_MAX_REDIRECTS=5
SKIPPER_RUN_MAX_MINUTES=25

# Interview study: uploaded sources and practice questions
SKIPPER_INTERVIEW_MAX_UPLOAD_BYTES=8000000
SKIPPER_INTERVIEW_MAX_SOURCE_CHARS=400000
SKIPPER_INTERVIEW_PRACTICE_QUESTIONS=8

# LibreOffice binary used for DOCX -> PDF conversion
SKIPPER_SOFFICE_PATH=soffice

SKIPPER_LOG_LEVEL=INFO
