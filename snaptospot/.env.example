# SnapToSpot backend configuration.
# Copy to .env and change SNAP_SECRET_KEY before exposing the app.

SNAP_ENV=dev
SNAP_DEBUG=true
SNAP_SECRET_KEY=change-me-in-production-use-at-least-32-bytes
SNAP_DATABASE_URL=sqlite:///./snaptospot.db
# Postgres (used from step 1 onward in production):
# SNAP_DATABASE_URL=postgresql+psycopg://snaptospot:snaptospot@localhost:5432/snaptospot
SNAP_ACCESS_TOKEN_MINUTES=15
SNAP_REFRESH_TOKEN_DAYS=30

# Crawling
SNAP_USE_PLAYWRIGHT=true
SNAP_CAPTURE_SCREENSHOTS=true
SNAP_MAX_PAGES=12
SNAP_FETCH_TIMEOUT_SECONDS=20
# Only enable for local fixture servers; production must block private addresses.
SNAP_SSRF_ALLOW_PRIVATE=false
SNAP_MEDIA_ROOT=var/media

# Optional: any OpenAI-compatible endpoint. Leave blank to use deterministic
# heuristics instead of an LLM for site understanding.
SNAP_LLM_API_KEY=
SNAP_LLM_BASE_URL=https://api.openai.com/v1
SNAP_LLM_MODEL=gpt-4o-mini
