# SnapToSpot backend configuration.
# Copy to .env and change SNAP_SECRET_KEY before exposing the app.

SNAP_ENV=dev
SNAP_DEBUG=true
SNAP_SECRET_KEY=change-me-in-production-use-at-least-32-bytes
SNAP_DATABASE_URL=sqlite:///./snaptospot.db
# Postgres (used from step 1 onward in production):
# SNAP_DATABASE_URL=postgresql+psycopg://snaptospot:snaptospot@localhost:5432/snaptospot
SNAP_ACCESS_TOKEN_MINUTES=15
SNAP_REFRESH_TOKEN_DAYS=30

# Crawling
# Card composition measures line boxes in Chromium too; run
# `playwright install chromium` once or composition falls back to an estimate.
SNAP_USE_PLAYWRIGHT=true
SNAP_CAPTURE_SCREENSHOTS=true
SNAP_MAX_PAGES=12
SNAP_FETCH_TIMEOUT_SECONDS=20
# Only enable for local fixture servers; production must block private addresses.
SNAP_SSRF_ALLOW_PRIVATE=false
SNAP_MEDIA_ROOT=var/media

# Optional: any OpenAI-compatible endpoint. Leave blank to use deterministic
# heuristics instead of an LLM for site understanding.
SNAP_LLM_API_KEY=
SNAP_LLM_BASE_URL=https://api.openai.com/v1
SNAP_LLM_MODEL=gpt-4o-mini

# Documents and retrieval. Embeddings use the same endpoint and key; without a
# key the pipeline hashes locally so uploads still work offline.
SNAP_EMBEDDING_MODEL=text-embedding-3-small
SNAP_EMBEDDING_DIMENSIONS=1536
SNAP_MAX_UPLOAD_FILES=5
SNAP_MAX_DOCUMENT_BYTES=10485760
SNAP_MAX_DOCUMENT_PAGES=40
SNAP_MAX_DOCUMENT_UNCOMPRESSED_BYTES=83886080
SNAP_DOCUMENT_RETENTION_DAYS=30
SNAP_RETRIEVAL_TOP_K=8
SNAP_RETRIEVAL_TOP_CHUNKS=3
# OCR needs Tesseract plus pytesseract.
SNAP_OCR_ENABLED=false

# Web search. Leave the provider or key blank to keep search disabled; gaps then
# wait for a typed answer or a document instead of blocking the run.
SNAP_SEARCH_PROVIDER=
SNAP_SEARCH_API_KEY=
# SNAP_SEARCH_ENDPOINT=          # optional override, e.g. a proxy
SNAP_SEARCH_TIMEOUT_SECONDS=20
SNAP_WEB_SEARCH_MAX_QUERIES=6
SNAP_WEB_SEARCH_RESULTS=3
SNAP_WEB_SEARCH_CACHE_DAYS=7
SNAP_WEB_SEARCH_MIN_SCORE=0.65
